{
  "name": "softhair-server",
  "version": "1.0.0",
  "description": "Servidor centralizado do SoftHair - Banco de dados e API para clientes",
  "main": "src/server.js",
  "scripts": {
    "start": "node --max-old-space-size=256 src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node src/scripts/initDb.js",
    "db:migrate": "node src/scripts/migrate.js",
    "db:backup": "node src/scripts/backup.js",
    "health": "node src/scripts/health-check.js",
    "test": "jest",
    "lint": "eslint src/"
  },
  "keywords": [
    "salon",
    "management",
    "api",
    "server",
    "centralized"
  ],
  "author": "SoftHair Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.94.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-slow-down": "^2.0.1",
    "express-validator": "^7.0.1",
    "groq-sdk": "^1.1.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.20.0",
    "uuid": "^9.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.0.3"
  },
  "engines": {
    "node": ">=18.0.0 <23"
  }
}
