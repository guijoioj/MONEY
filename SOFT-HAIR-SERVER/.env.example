# SOFT-HAIR-SERVER - Configurações de Ambiente

# Database Configuration
DATABASE_URL=postgresql://softhair:your_secure_password@localhost:5432/softhair_central
DATABASE_SSL=true

# Server Configuration
PORT=3000
NODE_ENV=production
SERVER_NAME=softhair-central

# Security Configuration
JWT_SECRET=your_jwt_secret_here_min_256_bits
JWT_EXPIRES_IN=7d
API_KEY_MASTER=your_master_api_key_here
HMAC_SECRET=your_hmac_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# CORS - Origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:19006,app://softhair.com

# SSL/TLS
FORCE_HTTPS=true
SSL_CERT_PATH=/etc/ssl/certs/softhair.crt
SSL_KEY_PATH=/etc/ssl/private/softhair.key
SSL_CA_PATH=/etc/ssl/certs/ca.crt

# WebSocket
WS_ENABLED=true
WS_PATH=/ws

# Logging
LOG_LEVEL=info
LOG_FILE=logs/server.log

# Backup
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/var/backups/softhair

# Admin Configuration
DEFAULT_ADMIN_EMAIL=admin@softhair.com
DEFAULT_ADMIN_PASSWORD=change_this_password
DEFAULT_ADMIN_NAME=Administrador

# Multi-tenancy (para múltiplos salões)
MULTI_TENANT=true
MAX_SALOES_PER_SERVER=100