# SOFT-HAIR-SERVER - Configurações de Ambiente

# Database Configuration
DATABASE_URL=postgresql://softhair:your_secure_password@localhost:5432/softhair_central
DATABASE_SSL=true

# Server Configuration
PORT=3000
NODE_ENV=production
SERVER_NAME=softhair-central

# Security Configuration
# JWT_SECRET deve ter no mínimo 256 bits (32 chars). Gere com: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_min_256_bits
# Lifetime curto (24h) com revogação via blacklist. Recomendado: 24h.
JWT_EXPIRES_IN=24h
# HMAC_SECRET é usado por utils/encryption.js e utils/helpers.js (assinaturas internas).
HMAC_SECRET=your_hmac_secret_here
# ENCRYPTION_KEY é usado por utils/encryption.js (AES-256-GCM). HEX de 32 bytes.
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=your_encryption_key_hex_32_bytes

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX=5

# CORS - Origens permitidas (separadas por vírgula). NUNCA use '*' em produção.
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:19006,app://softhair.com

# SSL/TLS
FORCE_HTTPS=true
SSL_CERT_PATH=/etc/ssl/certs/softhair.crt
SSL_KEY_PATH=/etc/ssl/private/softhair.key
SSL_CA_PATH=/etc/ssl/certs/ca.crt

# WebSocket
WS_ENABLED=true
WS_PATH=/ws

# Logging
LOG_LEVEL=info
LOG_FILE=logs/server.log

# Backup
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/var/backups/softhair

# Admin Configuration
# [C1] OBRIGATÓRIO em produção. Servidor não inicia sem DEFAULT_ADMIN_PASSWORD.
# Após primeiro login, a senha deve ser trocada (flag must_change_password).
DEFAULT_ADMIN_EMAIL=admin@softhair.com
DEFAULT_ADMIN_PASSWORD=change_this_password
DEFAULT_ADMIN_NAME=Administrador

# Multi-tenancy (para múltiplos salões)
MULTI_TENANT=true
MAX_SALOES_PER_SERVER=100

# AI (opcional) — usado em /api/ai/command
# Pelo menos uma das duas é obrigatória para o endpoint funcionar.
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
