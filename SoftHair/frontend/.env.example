# SoftHair Client Configuration
# Copie este arquivo para .env e configure suas variáveis

# SoftHair Server API URL
VITE_API_URL=http://localhost:3000/api

# Device configuration
VITE_DEVICE_NAME=Desktop SoftHair
VITE_DEVICE_TYPE=desktop

# Security
VITE_API_KEY=your_api_key_here

# Features
VITE_OFFLINE_ENABLED=true
VITE_AUTO_SYNC_INTERVAL=5

# Cache  
VITE_CACHE_DURATION=3600000

# UI Configuration  
VITE_TIMEZONE=America/Sao_Paulo
VITE_DATE_FORMAT=pt-BR
VITE_CURRENCY=BRL