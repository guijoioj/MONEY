# Database Configuration (sem caracteres especiais na senha)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=softhair
DB_USER=softhair
DB_PASSWORD=softhair123!
DATABASE_SSL=false

# URL alternativa (se necessário)
DATABASE_URL=postgresql://softhair:softhair123!@localhost:5432/softhair

# Security Configuration
NODE_ENV=development
FORCE_HTTPS=false
SECURE_HEADERS=true

# API Security - Generate strong keys
API_KEY=$(openssl rand -hex 32)
HMAC_SECRET=$(openssl rand -hex 64)
ENCRYPTION_KEY=$(openssl rand -hex 32)

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://localhost:5173,app://softhair.com

# JWT Configuration - Should be strong in production
JWT_SECRET=$(openssl rand -hex 64)
JWT_EXPIRES_IN=7d

# Default Admin
SOFTHAIR_DEFAULT_ADMIN_EMAIL=admin@salao.com
SOFTHAIR_DEFAULT_ADMIN_PASSWORD=StrongPassword123!
SOFTHAIR_DEFAULT_ADMIN_NAME=Administrador

PORT=3001