# Banco de dados PostgreSQL
DATABASE_URL=postgresql://softhair:softhair@localhost:5432/softhair
DATABASE_SSL=false

# JWT
JWT_SECRET=troque-por-uma-chave-secreta-forte-em-producao
JWT_EXPIRES_IN=7d

# Admin padrão (criado automaticamente na primeira execução)
SOFTHAIR_DEFAULT_ADMIN_EMAIL=admin@salao.com
SOFTHAIR_DEFAULT_ADMIN_PASSWORD=admin123
SOFTHAIR_DEFAULT_ADMIN_NAME=Administrador

# Diretório de dados (backups)
SOFTHAIR_ROOT_DIR=

# Porta do servidor
PORT=3001
