{
  "name": "softhair",
  "version": "3.1.4",
  "description": "SoftHair - Sistema de gestão para salões de beleza (Electron + SQLite + sync opcional)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "electron": "electron .",
    "dev": "electron . --dev",
    "backend:install": "cd backend && npm install",
    "backend:dev": "cd backend && npm run dev",
    "frontend:install": "cd frontend && npm install",
    "frontend:dev": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "build:electron": "npm run build:frontend && electron-builder",
    "build:win": "npm run build:frontend && electron-builder --win",
    "build:linux": "npm run build:frontend && electron-builder --linux",
    "build:mac": "npm run build:frontend && electron-builder --mac",
    "release:win": "npm run build:frontend && electron-builder --win --publish=always",
    "release:linux": "npm run build:frontend && electron-builder --linux --publish=always",
    "release:mac": "npm run build:frontend && electron-builder --mac --publish=always",
    "dist": "npm run build:frontend && electron-builder --publish=never",
    "postinstall": "npm run backend:install && npm run frontend:install"
  },
  "build": {
    "appId": "com.softhair.app",
    "productName": "SoftHair",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "MANUAL-DE-USO.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/.cache/**"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SoftHair"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "guijoioj",
        "repo": "MONEY",
        "releaseType": "release"
      }
    ]
  },
  "keywords": [
    "beauty",
    "salon",
    "management",
    "desktop",
    "electron",
    "sqlite"
  ],
  "author": "SoftHair",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3"
  }
}
